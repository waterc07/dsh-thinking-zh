{
  "name": "dsh-thinking-zh",
  "version": "0.1.0",
  "private": true,
  "description": "把 DeepSeek Harness 对话里折叠状态的英文思考预览自动翻译成中文（宿主侧同源代理 + 持久缓存 + 浏览器侧 DOM 就地替换）。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "waterc",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "translation",
    "reasoning",
    "thinking",
    "chinese",
    "zh-cn"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/waterc07/dsh-thinking-zh"
  },
  "homepage": "https://github.com/waterc07/dsh-thinking-zh",
  "bugs": {
    "url": "https://github.com/waterc07/dsh-thinking-zh/issues"
  },
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "files": ["lib", "cordis.patch.yml", "README.md"]
}
